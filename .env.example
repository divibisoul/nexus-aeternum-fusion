# Gemini / Google AI Studio
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted by the adapter
GOOGLE_API_KEY=

# Soul Mesh security
SOUL_MESH_HMAC_SECRET=

# N03 endpoint and peer endpoints
SOUL_MESH_N03_URL=
SOUL_MESH_N01_URL=
SOUL_MESH_N02_URL=
SOUL_MESH_N04_URL=
SOUL_MESH_N05_URL=
SOUL_MESH_N06_URL=

# Server-side auth for /api/cognitive (never expose service-role credentials)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
