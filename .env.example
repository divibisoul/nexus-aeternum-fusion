# Gemini / Google AI Studio
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted by the adapter
GOOGLE_API_KEY=

# Soul Mesh security
SOUL_MESH_HMAC_SECRET=

# N03 endpoint and peer endpoints
SOUL_MESH_N03_URL=
SOUL_MESH_N01_URL=
SOUL_MESH_N02_URL=
SOUL_MESH_N04_URL=
SOUL_MESH_N05_URL=
SOUL_MESH_N06_URL=
SOUL_MESH_N07_URL=
SOUL_N07_URL=
# Gemini Live
GEMINI_LIVE_MODEL=gemini-3.8-live

# Security-remediated dependency line is maintained by final-dependency-resolution workflow.

# N03 AgentScope multimodal agent runtime
SOUL_N03_AGENTSCOPE_ENABLED=false
SOUL_N03_AGENTSCOPE_ROOT=integrations/soul-upstream/agentscope
SOUL_N03_AGENTSCOPE_PYTHON=python3
SOUL_N03_AGENTSCOPE_RUNNER=scripts/agentscope_runner.py
SOUL_N03_AGENTSCOPE_MODEL=gemini-2.5-flash
SOUL_N03_AGENTSCOPE_TIMEOUT_MS=120000
