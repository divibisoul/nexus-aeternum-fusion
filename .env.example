# Gemini / Google AI Studio
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted by the adapter
GOOGLE_API_KEY=

# Soul Mesh security
SOUL_MESH_HMAC_SECRET=change-me-in-production

# N03 endpoint and peer endpoints
SOUL_MESH_N03_URL=
SOUL_MESH_N01_URL=
SOUL_MESH_N02_URL=
SOUL_MESH_N04_URL=
SOUL_MESH_N05_URL=
SOUL_MESH_N06_URL=

# Hybrid Supabase + IPFS storage
WEB3_STORAGE_TOKEN=your_web3_storage_token
WEB3_STORAGE_API_URL=https://api.web3.storage
WEB3_STORAGE_GATEWAY_URL=https://w3s.link/ipfs
