{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/vite-env.d.ts",
    "src/core/NexusCoreProcessor.ts",
    "src/core/NexusPilotPort.ts",
    "src/integration/SoulNexusBridge.ts",
    "src/soul-mesh/*.ts"
  ]
}
